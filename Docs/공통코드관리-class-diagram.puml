  +deleteCode(codeId, cmpnyCd) : void
  +checkChildren(codeId, cmpnyCd) : String
  -buildTree(flatList) : List<CodeTreeDTO>
  -isDuplicateKeyException(t) : boolean
  -resolveCreationId() : String
}

class CmmnCodeMapper <<Mapper>> {
  +selectCodeTree(params) : List<Map>
  +selectCodeDetail(params) : CmmnCodeResponseDTO
  +selectCodeDetailList(params) : List<CodeDetailDTO>
  +selectParentCode(params) : CmmnCodeResponseDTO
