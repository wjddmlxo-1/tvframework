class CmmnCodeRequestDTO <<Dto>> {
  -cmpnyCd : String
  -codeId : String
  -upperCodeId : String
  -useFl : String
  -codeCn : String
  -codeName : String
  -codeLangKey : String
  -codeDetailList : List<CodeDetailDTO>
}

class CmmnCodeResponseDTO <<Dto>> {
  -upperCodeId : String
  -upperCodeName : String
  -codeId : String
  -codeName : String
  -useFl : String
  -codeCn : String
  -codeLangKey : String
}

class CodeTreeDTO <<Dto>> {
  -codeId : String
  -name : String
  -upperCodeId : String
  -useFl : String
  -path : String
  -level : Integer
  -children : List<CodeTreeDTO>
}

class CodeDetailDTO <<Dto>> {
  -codeId : String
  -detailCodeId : String
  -detailCodeValue : String
  -codeLangKey : String
  -codeName : String
  -sortingSq : Integer
  -useFl : String
}

class CmmnCodeDuplicateKeyException <<Exception>> {
  -duplicateKey : String
  -duplicateDetailIndex : Integer
  +getDuplicateKey() : String
  +getDuplicateDetailIndex() : Integer
}

