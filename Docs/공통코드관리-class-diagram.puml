}

class CmmnCodeServiceImpl <<ServiceImpl>> {
  -cmmnCodeMapper : CmmnCodeMapper
  --
  +selectCodeTree(langGb, cmpnyCd) : List<CodeTreeDTO>
  +selectCodeDetail(codeId, langGb, cmpnyCd) : CmmnCodeResponseDTO
  +selectCodeDetailList(codeId, langGb, cmpnyCd) : List<CodeDetailDTO>
  +selectParentCode(codeId, langGb, cmpnyCd) : CmmnCodeResponseDTO
  +insertCode(requestDTO) : void
